{
  "name": "mecanimovil-app-proveedores",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --go --max-workers 1",
    "start:clear": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --go --max-workers 1 -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export": "expo export --platform web",
    "export:web": "expo export --platform web",
    "deploy:vercel:hook": "curl -fsS -X POST https://api.vercel.com/v1/integrations/deploy/prj_p5ArLTR43TKeYVxNtrNBd3RDEXRW/ncckJ5aige -H 'Content-Type: application/json'",
    "deploy:vercel:cli": "npx vercel@53.2.0 deploy --prod --yes",
    "lint": "expo lint",
    "e2e:checklist": "playwright test e2e/checklist-button-test.spec.ts --project=chromium",
    "e2e:network": "playwright test e2e/checklist-network-recovery.spec.ts --project=chromium",
    "e2e:consent": "playwright test e2e/consent-public-link.spec.ts --project=chromium",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 10000,
    "workerIdleMemoryLimit": "512MB",
    "maxWorkers": "50%",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup-after-env.js"
    ],
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/jest.setup.js",
      "!**/app.config.ts",
      "!**/__tests__/**"
    ],
    "moduleNameMapper": {
      "^@/app/design-system/(.*)$": "<rootDir>/design-system/$1",
      "^@/app/design-system$": "<rootDir>/design-system",
      "^@/app/components/(.*)$": "<rootDir>/components/$1",
      "^@/app/components$": "<rootDir>/components",
      "^@/app/services/(.*)$": "<rootDir>/services/$1",
      "^@/app/services$": "<rootDir>/services",
      "^@/(.*)$": "<rootDir>/$1",
      "^react-native/setup-env$": "<rootDir>/__mocks__/react-native/setup-env.js",
      "^react-native/asset-registry$": "<rootDir>/__mocks__/react-native/asset-registry.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.{ts,tsx}",
      "**/*.test.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/react-query": "^5.96.2",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-canvas": "^4.7.4",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@playwright/test": "^1.65.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "playwright": "^1.65.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.6.3"
  },
  "overrides": {
    "react-native-worklets": "0.10.1",
    "@react-native/jest-preset": "^0.88.1"
  },
  "private": true
}
